{
  "configVersion": "v3",
  "app": {
    "appId": 1129966,
    "appName": "NaviHUD",
    "appType": "app",
    "version": {
      "code": 3,
      "name": "1.0.2"
    },
    "icon": "icon.png",
    "vender": "maci",
    "description": "Navigation HUD for Amazfit Smartwatches"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.bg_service",
    "device:os.vibrate"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "2.0.0",
      "target": "3.0.0",
      "minVersion": "2.0"
    }
  },
  "targets": {
    "round": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "defaultLanguage": "hu-HU"
}
